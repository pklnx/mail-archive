# Copy to .env and fill in. Never commit .env.

# Password for the bundled PostgreSQL container.
POSTGRES_PASSWORD=change-me

# Encrypts stored IMAP passwords. Generate with:
#   openssl rand -base64 32
# Back it up: without it, stored IMAP passwords must be re-entered
# (archived mail is not encrypted and stays readable).
MAIL_ARCHIVE_SECRET_KEY=

# Where raw .eml files are stored on the host.
ARCHIVE_DIR=./data

# Files to import with `./ma import`, mounted read-only at /import.
#IMPORT_DIR=./import

# debug, info, warn or error
MAIL_ARCHIVE_LOG_LEVEL=info

# How often the web server syncs each enabled account (at least 5m; 0 = off).
MAIL_ARCHIVE_SYNC_INTERVAL=6h

# Require TOTP for all non-admin users too (admins always require TOTP).
MAIL_ARCHIVE_REQUIRE_2FA=false

# Web UI. By default only this computer can reach it. To use it from your
# network or a VPN, set the address to listen on (0.0.0.0 for all, or a LAN
# or Tailscale IP) and every host name you type in the browser, then put
# HTTPS in front (reverse proxy or `tailscale serve`).
#WEB_BIND=127.0.0.1
#WEB_PORT=8080
#MAIL_ARCHIVE_ALLOWED_HOSTS=localhost,127.0.0.1

# The address you open in the browser. Passkeys work only there: https://
# with a host name (like https://archive.example.ts.net), or
# http://localhost. Its host is allowed automatically. Changing the host
# later makes existing passkeys unusable. Default: http://localhost:WEB_PORT
#MAIL_ARCHIVE_PUBLIC_URL=https://archive.example.ts.net
