# Copy to .env and fill in. Never commit .env.

# Password for the bundled PostgreSQL container.
POSTGRES_PASSWORD=change-me

# Encrypts stored IMAP passwords and TOTP secrets; the web server refuses to
# start without it, and with another key than the one it started with
# before. Generate with:
#   openssl rand -base64 32
# Back it up: without it, stored IMAP passwords and TOTP must be set again
# (archived mail stays readable).
MAIL_ARCHIVE_SECRET_KEY=
# Or keep it in a file instead (not both): secret-key/secret.key in
# SECRET_KEY_DIR, mounted read-only as /secret-key, readable only by the
# container user (UID 65532, mode 0400). See docs/reference/configuration.md.
#SECRET_KEY_DIR=./secret-key
#MAIL_ARCHIVE_SECRET_KEY_FILE=/secret-key/secret.key

# Where raw .eml files are stored on the host.
ARCHIVE_DIR=./data

# Encryption at rest: the archive key that opens the keyring in the data
# directory. Create both once with `./ma encryption keygen`; it writes
# keys/archive.key (in ARCHIVE_KEY_DIR, mounted read-only as /keys) and
# prints a recovery key. Then uncomment the line below. Back up the key file
# apart from the data directory and keep the recovery key offline: without
# them encrypted mail cannot be recovered, backups included. A new instance
# (no user yet) turns encryption at rest on at its first start and does not
# start without the key.
#ARCHIVE_KEY_DIR=./keys
#MAIL_ARCHIVE_ARCHIVE_KEY_FILE=/keys/archive.key
# Or the key itself (for example a recovery key), instead of the file:
#MAIL_ARCHIVE_ARCHIVE_KEY=
# off: a new instance starts without encryption at rest. Test instances only.
#MAIL_ARCHIVE_ENCRYPTION_AT_SETUP=off

# The first admin from a setup link instead of `./ma user add`: put a token
# from `./ma setup token` into SECRET_KEY_DIR as setup.token (owned by UID
# 65532, mode 0400) and start the web server; the link
# MAIL_ARCHIVE_PUBLIC_URL/#setup=<token> then creates the first admin, once,
# within 7 days. See docs/guide/getting-started.md.
#MAIL_ARCHIVE_SETUP_TOKEN_FILE=/secret-key/setup.token

# Files to import with `./ma import`, mounted read-only at /import.
#IMPORT_DIR=./import

# GoBD exports (`./ma export --format gobd --out /export/...`), mounted at
# /export, outside the data directory. Exports are not encrypted; delete
# them once handed over.
#EXPORT_DIR=./export

# debug, info, warn or error
MAIL_ARCHIVE_LOG_LEVEL=info

# on (default here): the web server and the worker apply pending database
# migrations when they start, as `./ma migrate` does. off: they refuse to
# start while migrations are pending, until `./ma migrate` ran. Either way,
# back up before an upgrade (docs/guide/operations.md, "Upgrades").
#MAIL_ARCHIVE_MIGRATE_ON_START=on

# How often the web server syncs each enabled account (at least 5m; 0 = off).
# Accounts can have their own interval in the web UI or with
# `./ma account set-schedule`.
MAIL_ARCHIVE_SYNC_INTERVAL=6h
# The shortest interval any account is synced at (default 5m).
#MAIL_ARCHIVE_SYNC_INTERVAL_MIN=15m

# How often each folder is compared with the server to find messages deleted
# there and changed flags (at least 1h; 0 = only with the button or
# `./ma sync --reconcile`). Read-only, no message bodies.
MAIL_ARCHIVE_RECONCILE_INTERVAL=24h

# Tamper evidence: a signed attestation over the archived messages, written
# by the web server every interval (at least 1h; 0 = only `./ma attest`).
# Off until you create the key once with `./ma attest keygen`; then copy
# data/attest/signing.pub off this host. The key file defaults to
# data/attest/signing.key (/data/attest/signing.key in the container).
# See docs/reference/security.md.
#MAIL_ARCHIVE_ATTEST_INTERVAL=24h
#MAIL_ARCHIVE_ATTEST_KEY_FILE=/data/attest/signing.key

# How long the files of messages deleted by retention outlive their rows, so
# that a backup made meanwhile is complete (at least 1h, or 0 for none).
#MAIL_ARCHIVE_RETENTION_FILE_GRACE=168h

# Alerts when syncs of an account keep failing (wrong password, blocked
# login), and when they work again. Sent by the web server and by
# `./ma sync`. The URL and the authorization are secrets. Test with
# `./ma notify test`. See docs/guide/operations.md.
#MAIL_ARCHIVE_NOTIFY_WEBHOOK_URL=https://ntfy.sh/your-long-random-topic
#MAIL_ARCHIVE_NOTIFY_WEBHOOK_FORMAT=ntfy
#MAIL_ARCHIVE_NOTIFY_WEBHOOK_AUTHORIZATION=Bearer tk_...
# Failed syncs in a row before an account counts as failing (1-100).
#MAIL_ARCHIVE_ALERT_AFTER_FAILURES=3

# IMAP limits a large mailbox can reach. The defaults fit a 4 GB host;
# raising one costs memory in the web server (see "IMAP limits" in
# docs/guide/operations.md). An error caused by one of them names it.
# Messages a fill lists of one IMAP folder per pass (10000-10000000).
#MAIL_ARCHIVE_FILL_MAX_FOLDER_MESSAGES=500000
# Larger folders are not reconciled (10000-20000000).
#MAIL_ARCHIVE_RECONCILE_MAX_MESSAGES=2000000
# Folders one IMAP account may list (100-200000).
#MAIL_ARCHIVE_IMAP_MAX_FOLDERS=10000
# How long an IMAP server may send nothing during a command (30s-30m).
#MAIL_ARCHIVE_IMAP_IDLE_TIMEOUT=2m

# Receive a copy of every message from your mail server over SMTP
# (journaling, for smtp accounts). Off unless the listen address is set.
# A Postfix on this host connects from the Compose network's gateway
# (172.x), so that network must be allowed. See docs/guide/journaling.md.
#MAIL_ARCHIVE_SMTP_LISTEN=:2525
#MAIL_ARCHIVE_SMTP_ALLOWED_NETWORKS=172.16.0.0/12
# At least Postfix's message_size_limit: Postfix drops refused copies.
#MAIL_ARCHIVE_SMTP_MAX_SIZE=50M
#MAIL_ARCHIVE_SMTP_HOSTNAME=archive.example.com
# Where the SMTP port is published on the host (default 127.0.0.1:2525).
#SMTP_BIND=127.0.0.1
#SMTP_PORT=2525

# Require TOTP for all non-admin users too (admins always require TOTP).
MAIL_ARCHIVE_REQUIRE_2FA=false

# Web UI. By default only this computer can reach it. To use it from your
# network or a VPN, set the address to listen on (0.0.0.0 for all, or a LAN
# or Tailscale IP) and every host name you type in the browser, then put
# HTTPS in front (reverse proxy or `tailscale serve`).
#WEB_BIND=127.0.0.1
#WEB_PORT=8080
#MAIL_ARCHIVE_ALLOWED_HOSTS=localhost,127.0.0.1

# Behind a reverse proxy, its address, so that the audit log and the login
# limits see the client from X-Forwarded-For instead of the proxy, and its
# X-Forwarded-Proto: https makes the session cookie Secure and sends HSTS.
# Under Docker Compose, Caddy or tailscale serve on the host connect from the
# Compose network's gateway: set that. List only the proxy, and only if all
# access goes through it (see docs: Audit log, Security).
#MAIL_ARCHIVE_TRUSTED_PROXIES=172.18.0.1

# The address you open in the browser. Passkeys work only there: https://
# with a host name (like https://archive.example.ts.net), or
# http://localhost. Its host is allowed automatically. Changing the host
# later makes existing passkeys unusable. Default: http://localhost:WEB_PORT
#MAIL_ARCHIVE_PUBLIC_URL=https://archive.example.ts.net

# The image of the web server and the CLI. A release bundle uses its own
# version (ghcr.io/pklnx/mail-archive:X.Y.Z); a clone builds it locally.
#MAIL_ARCHIVE_IMAGE=ghcr.io/pklnx/mail-archive:1.0.0

# Background jobs (extracting attachment text for search). By default the web
# server runs them. To run them in a separate container with its own memory
# limit (768 MiB, one core), enable the worker service and turn them off in
# the web server; then start both with `docker compose up -d web worker`.
# See docs/guide/operations.md, "Background jobs".
#COMPOSE_PROFILES=worker
#WEB_JOB_WORKERS=0
# Jobs the worker runs at a time (1-8); each needs about 224 MiB and a core.
#WORKER_JOB_WORKERS=1
# mem_limit (768m) minus 128 MiB per worker minus 64 MiB: 448MiB for 2.
#WORKER_GOMEMLIMIT=576MiB
